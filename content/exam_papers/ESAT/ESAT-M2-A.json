   "difficulty": 3,
   "stem_html": "<p>What is the coefficient of <span class=\"math\">x</span><sup>2</sup> in the expansion of</p><p style=\"text-align:center\">(2 \u2212 <span class=\"math\">x</span>)<sup>6</sup> (1 + <span class=\"math\">x</span>)<sup>2</sup> ?</p>",
