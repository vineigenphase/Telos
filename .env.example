# Telos environment variables. Copy to .env (gitignored) and fill in.
# Production values live in Railway: `railway variables`.

# ── Database ────────────────────────────────────────────────────────────────
# Neon Postgres. Use the DIRECT connection string, not the -pooler one:
# psycopg3's prepared statements clash with Neon's PgBouncer. If you do point
# at the pooler, set prepare_threshold=None on the pool in db.py.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
DB_POOL_MAX=5

# ── Flask ───────────────────────────────────────────────────────────────────
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_hex-32

# Canonical hostname, no scheme, no trailing slash. Setting this turns on the
# 301-to-canonical redirect AND secure session cookies, so leave it EMPTY for
# local http development or you won't be able to stay logged in.
CANONICAL_HOST=telosapp.co.uk

# Where uploads live. On Railway this is the mounted volume (/data); locally it
# defaults to ./storage if unset.
STORAGE_DIR=/data

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without RESEND_API_KEY the app still runs and the password-reset flow still
# works, but the message is written to the log instead of being delivered.
# The sending domain must be verified in Resend before mail to real inboxes
# will arrive.
RESEND_API_KEY=re_...
MAIL_FROM=Telos <noreply@telosapp.co.uk>

# ── Stripe (test keys shown; live keys only in Railway) ─────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
# Signing secret for the endpoint pointing at /subscription/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
